# Fallback in case the Claude Agent SDK does not pick up the Claude Code Pro
# session automatically (see docs/weeks/week1.md, "Авторизація").
ANTHROPIC_API_KEY=
# Required by the OpenAI prober.
OPENAI_API_KEY=

# Stance classifier: MLflow tracking server (defaults to a local SQLite file) and the
# registry URI the API loads. docker-compose sets both for the containers.
MLFLOW_TRACKING_URI=
STANCE_MODEL_URI=
